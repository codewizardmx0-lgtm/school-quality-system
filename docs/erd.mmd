        datetime submitted_at
        datetime updated_at
        varchar status
    }
    INTERNAL_REVIEW_NOTES {
        int note_id PK
        int report_id FK
        int author_user_id FK
        varchar text
        datetime created_at
        datetime updated_at
    }
    PLAN_REVIEW_NOTES {
        int note_id PK
        int plan_id FK
        int author_user_id FK
        varchar text
        datetime created_at
        datetime updated_at
    }
    SUPERVISOR_NOTES {
        int note_id PK
        int submission_id FK
        int author_user_id FK
        varchar text
        datetime created_at
        datetime updated_at
    }
    COMPLETION_REQUESTS {
        int request_id PK
        int submission_id FK
        int issued_by_user_id FK
        datetime created_at
        datetime resolved_at
        datetime updated_at
        varchar status
    }
    COMPLETION_REQUEST_ITEMS {
        int request_item_id PK
        int request_id FK
        int indicator_id FK
        int evidence_id FK
        varchar missing_description
        varchar status
        datetime created_at
        datetime updated_at
    }
    NOTIFICATIONS {
        int notification_id PK
        int recipient_user_id FK
        varchar title
        varchar message
        varchar type
        varchar related_entity_type
        int related_entity_id
        boolean is_read
        datetime created_at
        datetime read_at
    }
    AI_ANALYSIS {
        int analysis_id PK
        int evaluation_id FK
        int requested_by_user_id FK
        datetime analysis_date
        varchar input_scope
        varchar summary
        varchar status
        datetime created_at
        datetime updated_at
    }
    AI_RECOMMENDATIONS {
        int recommendation_id PK
        int analysis_id FK
        int improvement_action_id FK
        varchar type
        varchar title
        varchar description
        varchar priority
        varchar human_modifications
        varchar status
        datetime created_at
        datetime updated_at
    }

