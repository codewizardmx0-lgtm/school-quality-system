    %% ========= (1) الهوية والجهات والصلاحيات =========
    ROLES {
        int role_id PK
        varchar role_name UK
        varchar description
    }
    PERMISSIONS {
        int permission_id PK
        varchar permission_code UK
        varchar permission_name
        varchar description
    }
    ROLE_PERMISSIONS {
        int role_id PK,FK
        int permission_id PK,FK
        datetime assigned_at
    }
    SCHOOLS {
        int school_id PK
        varchar school_name
        varchar educational_stage
        varchar identification_data
        varchar educational_district
        varchar governorate
        varchar status
    }
    MINISTRIES {
        int ministry_id PK
        varchar ministry_name
        varchar description
    }
    USERS {
        int user_id PK
        int school_id FK
        int ministry_id FK
        varchar username UK
        varchar password_hash
        varchar full_name
        varchar email
        varchar user_type
        varchar status
        datetime created_at
        datetime updated_at
    }
    USER_ROLES {
        int user_id PK,FK
        int role_id PK,FK
        datetime assigned_at
        datetime revoked_at
        boolean active
    }
    SESSIONS {
        int session_id PK
        int user_id FK
        varchar session_token UK
        datetime started_at
        datetime ended_at
        boolean active
        datetime created_at
        datetime updated_at
    }

    %% ========= (2) الإطار المرجعي والإصدارات وأدوات التحقق =========
    STANDARD_VERSIONS {
        int version_id PK
        varchar version_no UK
        date issue_date
        varchar source_organization
        varchar source_number
        varchar source_description
        varchar status
        datetime created_at
        datetime updated_at
    }
    STANDARDS {
        int standard_id PK
        int version_id FK
        varchar code
        varchar name
        varchar description
        decimal weight
        datetime created_at
        datetime updated_at
    }
    SUB_STANDARDS {
        int sub_standard_id PK
        int standard_id FK
        varchar code
        varchar name
        varchar description
        datetime created_at
        datetime updated_at
    }
    INDICATORS {
        int indicator_id PK
        int sub_standard_id FK
        varchar code
        varchar name
        varchar description
        decimal weight
        varchar status
        datetime created_at
        datetime updated_at
    }
    SCORE_LEVELS {
        int score_level_id PK
        int standard_version_id FK
        int score_value
        varchar label
        varchar general_description
        int display_order
    }
    INDICATOR_SCORE_DESCRIPTORS {
        int descriptor_id PK
        int indicator_id FK
        int score_level_id FK
        int standard_version_id FK
        varchar label
        varchar description
        int display_order
        boolean is_active
    }
    INDICATOR_EVIDENCE_REQUIREMENTS {
        int requirement_id PK
        int indicator_id FK
        int standard_version_id FK
        varchar title
        varchar description
        boolean required
        int display_order
    }
    VERIFICATION_TOOLS {
        int tool_id PK
        varchar name
        varchar tool_type
        varchar description
        boolean approved
        datetime created_at
        datetime updated_at
    }
    INDICATOR_VERIFICATION_METHODS {
        int id PK
        int indicator_id FK
        int tool_id FK
        boolean required
        varchar usage_guidance
        datetime created_at
    }

    %% ========= (3) الدورات والتقييم والنتائج والشواهد =========
    EVALUATION_CYCLES {
        int cycle_id PK
        int version_id FK
        varchar academic_year
        date start_date
        date end_date
        varchar status
        datetime created_at
        datetime updated_at
    }
    CYCLE_PARTICIPATIONS {
        int cycle_id PK,FK
        int school_id PK,FK
        datetime created_at
        datetime updated_at
    }
    EVALUATIONS {
        int evaluation_id PK
        int cycle_id FK
        int school_id FK
        int created_by_user_id FK
        varchar status
        datetime created_at
        datetime updated_at
    }
    EVALUATION_RESULTS {
        int result_id PK
        int evaluation_id FK
        int indicator_id FK
        int score_descriptor_id FK
        int standard_version_id FK
        int evaluator_user_id FK
        int score
        varchar textual_result
        varchar completion_status
        datetime created_at
        datetime updated_at
    }
    EVIDENCES {
        int evidence_id PK
        int result_id FK
        int indicator_id FK
        varchar title
        varchar description
        varchar justification
        datetime created_at
        datetime updated_at
    }
    EVIDENCE_VERSIONS {
        int evidence_version_id PK
        int evidence_id FK
        int version_no
        boolean current
        datetime created_at
        datetime updated_at
    }
    ATTACHMENTS {
        int attachment_id PK
        varchar target_type
        int target_id
        varchar file_name
        varchar file_type
        bigint file_size
        varchar storage_uri
        datetime created_at
        datetime updated_at
    }
    NOTES {
        int note_id PK
        int result_id FK
        int author_user_id FK
        varchar text
        datetime created_at
        datetime updated_at
    }
    EVALUATION_RESULT_VERIFICATION_METHODS {
        int id PK
        int evaluation_result_id FK
        int tool_id FK
    }

    %% ========= (4) خطط التحسين وإجراءاتها =========
    IMPROVEMENT_AREAS {
        int area_id PK
        int result_id FK
        int indicator_id FK
        varchar name
        varchar description
        varchar priority
        datetime created_at
        datetime updated_at
    }
    IMPROVEMENT_PLANS {
        int plan_id PK
        int cycle_id FK
        int school_id FK
        int created_by_user_id FK
        varchar title
        date start_date
        date end_date
        varchar status
        varchar progress_description
        datetime created_at
        datetime updated_at
    }
    PLAN_IMPROVEMENT_AREAS {
        int plan_id PK,FK
        int area_id PK,FK
        datetime created_at
    }
    IMPROVEMENT_ACTIONS {
        int action_id PK
        int plan_id FK
        int area_id FK
        varchar title
        varchar responsible_person_description
        date start_date
        date due_date
        varchar status
        varchar progress_description
        datetime created_at
        datetime updated_at
    }

