    SCHOOLS ||--o{ SCHOOL_DOCUMENTS : ""
    SCHOOL_DOCUMENTS ||--o{ DOCUMENT_VERSIONS : ""
    EVALUATIONS ||--o{ EVIDENCE_LINKS : ""
    INDICATORS ||--o{ EVIDENCE_LINKS : ""
    DOCUMENT_VERSIONS ||--o{ EVIDENCE_LINKS : ""
    EVALUATION_RESULTS ||--o{ EVIDENCE_LINKS : ""

    %% المخرجات والاستكمال
    EVALUATIONS ||--o{ REPORTS : ""
    REPORTS ||--o{ EVALUATION_SUBMISSIONS : ""
    REPORTS ||--o{ INTERNAL_REVIEW_NOTES : ""
    EVALUATION_SUBMISSIONS ||--o{ COMPLETION_REQUESTS : ""
    EVALUATION_SUBMISSIONS ||--o{ SUPERVISOR_NOTES : ""
