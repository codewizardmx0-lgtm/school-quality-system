    SCHOOLS ||--o{ EVALUATIONS : ""
    EVALUATIONS ||--o{ EVALUATION_RESULTS : ""
    INDICATORS ||--o{ EVALUATION_RESULTS : ""
    INDICATOR_SCORE_DESCRIPTORS ||--o{ EVALUATION_RESULTS : ""
    EVALUATION_RESULTS ||--o{ NOTES : ""
