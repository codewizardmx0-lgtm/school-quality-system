    SCHOOLS ||--o{ IMPROVEMENT_PLANS : ""
    IMPROVEMENT_PLANS ||--o{ PLAN_IMPROVEMENT_AREAS : ""
    IMPROVEMENT_AREAS ||--o{ PLAN_IMPROVEMENT_AREAS : ""
    PLAN_IMPROVEMENT_AREAS ||--o{ IMPROVEMENT_ACTIONS : ""
    IMPROVEMENT_PLANS ||--o{ PLAN_REVIEW_NOTES : ""
